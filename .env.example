# Copy this file to .env and adjust as needed. All values shown are defaults.

VERIMEDIA_ENV=development
VERIMEDIA_DEBUG=true
VERIMEDIA_HOST=127.0.0.1
VERIMEDIA_PORT=8000

# Restrict this to your packed extension's origin in production, e.g.
# chrome-extension://<your-extension-id>
VERIMEDIA_ALLOWED_ORIGINS=*

VERIMEDIA_DEEPFAKE_THRESHOLD=0.55
VERIMEDIA_DEEPFAKE_SUSPICIOUS=0.35
VERIMEDIA_VIDEO_MAX_FRAMES=24

VERIMEDIA_MISINFO_FALSE=0.62
VERIMEDIA_MISINFO_TRUE=0.62
VERIMEDIA_RETRIEVAL_TOP_K=5

# Drop in a trained EfficientNet(-GRU) checkpoint exported to ONNX — see
# app/pipelines/model_backend.py. Leave blank to use the offline forensic
# heuristic engine.
VERIMEDIA_ONNX_MODEL_PATH=

# Live web retrieval for the misinformation pipeline (optional) — see
# app/pipelines/retrieval_backend.py. Leave blank to use the local corpus.
VERIMEDIA_RETRIEVAL_PROVIDER=
VERIMEDIA_RETRIEVAL_API_KEY=

VERIMEDIA_CACHE_TTL=604800
